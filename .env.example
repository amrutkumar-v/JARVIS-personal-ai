# === JARVIS AI provider configuration =======================================
# Copy this file to `.env.local` and fill in your own values.
# NEVER commit a real key. This file ships with placeholders only.

# --- Option A: direct connection (keyless local endpoints only) ---
# OpenAI-compatible API base URL (e.g. an Ollama / LM Studio keyless endpoint).
# The client talks to this URL directly. NOTE: a browser bundle can NEVER hold
# JARVIS_API_KEY (Vite exposes only VITE_* vars), so for keyed endpoints use
# Option C below. Leave empty to fall back to the local development provider (mock).
VITE_JARVIS_AI_BASE_URL=

# Model name served by the endpoint, e.g. gpt-4o-mini or llama3.2.
VITE_JARVIS_AI_MODEL=

# --- Option B: same-origin DEV proxy (key stays server-side, dev only) ---
# Enable the Vite dev proxy, which forwards /api/ai/* to the target below and
# injects the Authorization header from JARVIS_API_KEY. Use this when you must
# not ship the key in the frontend bundle.
# VITE_JARVIS_AI_USE_PROXY=true
# VITE_JARVIS_AI_PROXY_TARGET=https://api.openai.com/v1
# Then point the client at the proxy path:
# VITE_JARVIS_AI_PROXY_URL=/api/ai

# --- Option C: same-origin production proxy (RECOMMENDED for keyed APIs) ---
# The JARVIS Core backend (npm run backend) serves the same /api/ai/* paths and
# injects JARVIS_API_KEY server-side. Configure it directly below, then point
# the client at the proxy path. Works for chat AND embeddings.
# VITE_JARVIS_AI_PROXY_URL=/api/ai

# API key placeholder. Put your real key in `.env.local` only (git-ignored).
# The backend proxy reads it from the SERVER process, never the browser.
JARVIS_API_KEY=

# Backend AI proxy upstream (read by the server process via `npm run backend`).
# JARVIS_AI_BASE_URL=https://api.openai.com/v1
# Optional upstream timeout in ms. Defaults to 60000.
# JARVIS_AI_TIMEOUT_MS=60000

# Sampling temperature (0.0 - 2.0). Defaults to 0.7 when omitted.
VITE_JARVIS_AI_TEMPERATURE=0.7

# Max generated tokens per reply. Defaults to 1024 when omitted.
VITE_JARVIS_AI_MAX_TOKENS=1024

# --- Phase 13 structured reasoning (same endpoint, stricter request) ---
# When the deterministic planner hits a REAL gap (a novel/chained goal it cannot
# plan), a reasoning-capable provider answers with a structured plan instead of
# free text. The engine forces `response_format: json_object`, an LLM-side
# temperature cap of 0.3 and a `max_tokens` cap of 512 for THIS request, and
# strictly validates the output against the registered capability allow-list.
# No additional variables are required: it uses the same VITE_JARVIS_AI_*
# values above. Leave them empty and the fallback is the local (mock) provider,
# which answers deterministically and never calls a reasoning endpoint.

# Conversation persistence: maximum number of messages kept in local storage.
# Defaults to 100 when omitted. Older messages are trimmed first.
VITE_JARVIS_HISTORY_LIMIT=100

# === Embedding provider configuration (semantic memory) ======================
# Optional. When unset, JARVIS uses the deterministic (offline/test) embedding
# provider, which provides NO real semantic meaning. Configure a real
# OpenAI-compatible embeddings endpoint for production semantic retrieval.

# Base URL of an OpenAI-compatible /embeddings endpoint
# (OpenAI / Azure / Ollama / LM Studio / vLLM, ...). Leave empty to fall back to
# VITE_JARVIS_AI_BASE_URL, then to the deterministic provider.
# VITE_JARVIS_EMBEDDING_BASE_URL=

# Optional same-origin proxy for embeddings (key stays server-side; served by the
# Vite dev proxy in dev and the JARVIS Core backend in production). Takes
# precedence over BASE_URL when set.
# VITE_JARVIS_EMBEDDING_PROXY_URL=

# Model served by the endpoint. Merges with JARVIS_API_KEY below.
# VITE_JARVIS_EMBEDDING_MODEL=text-embedding-3-small

# Optional dimensions override (auto-derived for common models otherwise).
# VITE_JARVIS_EMBEDDING_DIMENSIONS=

# The embeddings endpoint uses the same JARVIS_API_KEY placeholder above.

# === Vector index configuration (cross-instance semantic memory) =============
# Optional. Storage key for the persistent companion vector index that
# semantic search reads from (shared across MemoryManager instances / tabs on
# the same origin). Defaults to 'jarvis.memory.vectors' when omitted.
# VITE_JARVIS_MEMORY_VECTOR_KEY=jarvis.memory.vectors

# === Memory lifecycle configuration (forgetting & consolidation) =============
# Optional. The lifecycle safety net archives stale and/or over-capacity
# memories (recoverable, never deleted). These are runtime defaults; the same
# values can be passed per-run via runLifecycle()/LifecycleConfig.

# Master switch for automatic consolidation. Defaults to true.
# VITE_JARVIS_MEMORY_LIFECYCLE_ENABLED=true

# Archive items older than this many days (when at/below the importance floor;
# protected items are never archived by age). Defaults to 365.
# VITE_JARVIS_MEMORY_FORGET_AFTER_DAYS=365

# === Vision understanding configuration (Phase 1.8) ===========================
# REAL visual computer control. Optional: leave UNSET and no vision provider
# is bound — the app reports visual understanding as unavailable, no visual
# tools are registered, and nothing is ever fabricated.
#
# OpenAI-compatible vision endpoint (OpenAI / Azure / Ollama / LM Studio /
# vLLM with a vision model, ...). A screenshot is sent ONLY as a data-URI
# image_url; the endpoint must keep output JSON-bounded for UI elements.
# VITE_JARVIS_VISION_BASE_URL=
#
# Vision model served by the endpoint (e.g. gpt-4o-mini / qwen2.5-vl).
# VITE_JARVIS_VISION_MODEL=
#
# Uses the same JARVIS_API_KEY placeholder above (optional for local
# endpoints that need no auth).

# === Native Windows agent configuration (Phase 1.2) ==========================
# Optional. When set, the web app talks to a local native agent (see
# docs/native-windows-agent.md) that performs REAL Windows filesystem
# operations inside configured allowed roots. Leave UNSET for browser-only
# mode (File System Access API). The agent only ever performs typed,
# allow-listed operations — never arbitrary shell commands.
#
# VITE_NATIVE_AGENT_URL=http://127.0.0.1:8765
#
# Bearer token the agent requires. Generate one on the agent side
# (agent config / --token / env JARVIS_NATIVE_TOKEN) and mirror it here.
# VITE_NATIVE_AGENT_TOKEN=

# === Persistent JARVIS Core backend configuration (Phase 2.8) ================
# The always-on backend is served by `npm run backend` (or the Windows startup
# task installed via `npm run install:startup`). The frontend auto-connects to
# it and mirrors its live SSE stream.
#
# Backend base URL. Defaults to `http://localhost:8787` when omitted. For phone
# access on the LAN, use your PC's IP, e.g. http://192.168.1.20:8787.
# VITE_JARVIS_BACKEND_URL=http://localhost:8787
#
# Shared bearer token guarding every backend endpoint / SSE stream. When set,
# the SAME value must be configured on the backend process via
# JARVIS_BACKEND_TOKEN (otherwise the frontend stream is rejected).
# VITE_JARVIS_BACKEND_TOKEN=
#
# Overridable bounded reconnect budget (number of attempts). Defaults to 6.
# VITE_JARVIS_BACKEND_MAX_RECONNECT_ATTEMPTS=6
#
# Overridable reconnect backoff base (ms). Defaults to 700.
# VITE_JARVIS_BACKEND_RECONNECT_BASE_MS=700
#
# Overridable assistant→backend mirror throttle (ms). Defaults to 1500.
# VITE_JARVIS_BACKEND_MIRROR_THROTTLE_MS=1500

# ── Backend process config (env read by server/dist/index.js) ────────────────
# Port. Defaults to 8787.
# JARVIS_BACKEND_PORT=8787
#
# Host to bind. Defaults to 0.0.0.0 (reachable from LAN for /phone).
# JARVIS_BACKEND_HOST=0.0.0.0
#
# Bearer token required by backend endpoints. Should match VITE_JARVIS_BACKEND_TOKEN.
# JARVIS_BACKEND_TOKEN=
#
# Optional path to a built JARVIS frontend to serve (defaults to the repo's own dist/).
# JARVIS_BACKEND_STATIC_DIR=
#
# Native agent base URL the backend supervises. Defaults to http://127.0.0.1:8765.
# JARVIS_BACKEND_NATIVE_URL=http://127.0.0.1:8765
#
# Optional CORS origin allow-list passed to the native agent as --allowed-origins
# (comma-separated). The agent already restricts browser origins to the local
# loopback set (http://localhost:*, http://127.0.0.1:*, http://[::1]*) and
# Origin "null"; requests without an Origin header (curl/probes) stay allowed.
# Set this to grant an explicit extra origin, e.g. your LAN IP or reverse proxy.
# Any denied origin gets 403 "origin_denied" with no CORS headers. Empty = default.
# JARVIS_BACKEND_NATIVE_ALLOWED_ORIGINS=
