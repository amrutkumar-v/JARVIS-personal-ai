# JARVIS environment variable reference.
#
# COPY THIS FILE TO `.env.local` AND FILL IN YOUR VALUES. Never commit real
# secrets. `.env.example` contains variable names and documentation only.
#
# Two env domains:
#
#   * SERVER process env — read by the Vite dev AI proxy (vite.config.ts) and by
#     the JARVIS Core backend (server/src/index.ts). Both load `.env.local` when
#     present (`npm run dev` via loadEnv; `npm run backend` via
#     `--env-file-if-exists=.env.local`). Keys NEVER reach the browser.
#
#   * VITE_* browser env — compiled into the client by Vite. Never put a real
#     API key in a VITE_* variable.

# ──────────────────────────────── SERVER: AI ────────────────────────────────
# The JARVIS AI router (server/src/aiProvider.ts) serves chat, vision and
# embeddings from ONE of these providers, chosen by
#   JARVIS_AI_PRIMARY_PROVIDER  (explicit mode, recommended)
# or the legacy single-upstream mode when it is NOT set (back-compat).

# Explicit mode: pick the primary provider. One of:
#   auto | gemini | openai | anthropic | openrouter | local | ollama | lmstudio
# When unset the router uses the legacy single-upstream mode below.
#
#   auto — route across every usable provider, ordered by REAL observed health
#          (a provider that just failed is tried last, and a provider is only
#          ever reported CONNECTED after a successful call in this process).
#          Providers whose credential is missing are reported KEY_REQUIRED, and
#          a running local engine is discovered automatically.
JARVIS_AI_PRIMARY_PROVIDER=

# Ordered extra providers used on retryable failure (comma list, e.g.
# 'openai,anthropic'). Leave empty to disable failover.
# With JARVIS_AI_PRIMARY_PROVIDER=auto this list is the PREFERRED ORDER; the
# health of each provider still decides which one is tried first.
JARVIS_AI_FALLBACK_PROVIDERS=

# Strict pin for the whole server (never fails over). Optional.
JARVIS_AI_PINNED_PROVIDER=

# Providers the router must never use (comma list, e.g. 'openai'). They are
# reported as DISABLED instead of looking like a missing key. Optional.
JARVIS_AI_DISABLED_PROVIDERS=

# Google Gemini (capabilities: chat, vision, embeddings).
GEMINI_API_KEY=
GEMINI_AI_BASE_URL=
GEMINI_AI_MODEL=gemini-3.6-flash
GEMINI_VISION_MODEL=gemini-3.6-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-2-preview
GEMINI_AI_TIMEOUT_MS=60000

# OpenAI (capabilities: chat, vision, embeddings).
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_AI_MODEL=gpt-4o-mini
OPENAI_VISION_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_AI_TIMEOUT_MS=60000

# Anthropic Claude (capabilities: chat, vision; NO embeddings).
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_AI_MODEL=claude-sonnet-4-5
ANTHROPIC_VISION_MODEL=claude-sonnet-4-5
ANTHROPIC_AI_TIMEOUT_MS=60000

# OpenRouter (capabilities: chat, vision; NO embeddings).
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_AI_MODEL=openai/gpt-4o-mini
OPENROUTER_VISION_MODEL=openai/gpt-4o-mini
OPENROUTER_AI_TIMEOUT_MS=60000

# Local OpenAI-compatible endpoint (generic). Both BASE_URL and MODEL are
# REQUIRED for this provider to appear; embeddings only when an embedding model
# is declared.
JARVIS_LOCAL_AI_BASE_URL=
JARVIS_LOCAL_AI_MODEL=
JARVIS_LOCAL_AI_VISION_MODEL=
JARVIS_LOCAL_AI_EMBEDDING_MODEL=
JARVIS_LOCAL_AI_KEY=
JARVIS_LOCAL_AI_TIMEOUT_MS=180000

# Ollama / LM Studio (keyless, discovered). Only the BASE_URL is needed: JARVIS
# really queries the engine for its installed models (Ollama GET /api/tags, LM
# Studio GET /models) and uses the first one when no model is pinned here. A
# reachable engine with no models is reported MODEL_UNAVAILABLE (not CONNECTED).
# Ollama's OpenAI-compatible API lives under /v1; JARVIS appends it for you.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_AI_MODEL=
OLLAMA_VISION_MODEL=
OLLAMA_EMBEDDING_MODEL=
OLLAMA_AI_TIMEOUT_MS=180000

LMSTUDIO_BASE_URL=http://localhost:1234/v1
LMSTUDIO_AI_MODEL=
LMSTUDIO_VISION_MODEL=
LMSTUDIO_EMBEDDING_MODEL=
LMSTUDIO_AI_TIMEOUT_MS=180000

# Legacy mode (JARVIS_AI_PRIMARY_PROVIDER unset). The router acts as the old
# single-upstream proxy. Upstream chosen exactly like before:
#   baseUrl = VITE_JARVIS_AI_PROXY_TARGET || JARVIS_AI_BASE_URL ||
#             Gemini OpenAI-compatible endpoint
#   key     = GEMINI_API_KEY || JARVIS_API_KEY || OPENAI_API_KEY
# When no key AND no base URL is set, /api/ai reports `ai_not_configured` /
# MISCONFIGURED — an honest refusal, never a fake provider.
GEMINI_API_KEY=
JARVIS_API_KEY=
OPENAI_API_KEY=
JARVIS_AI_BASE_URL=
JARVIS_AI_TIMEOUT_MS=60000

# Dev server only: force the dev AI proxy (in legacy mode) to a specific
# upstream base URL (VITE_JARVIS_AI_PROXY_TARGET).
VITE_JARVIS_AI_PROXY_TARGET=

# ──────────────────────────────── SERVER: BACKEND ───────────────────────────
# JARVIS Core backend (persistent server on port 8787 by default).
JARVIS_BACKEND_HOST=127.0.0.1
JARVIS_BACKEND_PORT=8787
# Required server-side bearer token for non-browser API clients. Browser UI
# uses an HttpOnly SameSite session cookie and never receives this value.
JARVIS_BACKEND_TOKEN=
# Explicit browser CORS origins; include local Vite origins only while developing.
JARVIS_BACKEND_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
JARVIS_BACKEND_DATA_DIR=
JARVIS_BACKEND_STATIC_DIR=
JARVIS_BACKEND_SILENT=false

# Native (Windows) agent supervision + probing.
JARVIS_BACKEND_NATIVE_URL=http://127.0.0.1:8765
JARVIS_BACKEND_NATIVE_TOKEN=
JARVIS_BACKEND_NATIVE_ALLOWED_ORIGINS=
JARVIS_BACKEND_SUPERVISE_NATIVE=true
JARVIS_NATIVE_CMD=
JARVIS_NATIVE_AGENT=
JARVIS_NATIVE_CONFIG=

# ──────────────────────────────── SERVER: ANDROID COMPANION ──────────────────
# Phase 4.1 — real Android companion. The main backend stays loopback-only; the
# Android app reaches JARVIS through a SEPARATE narrow LAN listener that exposes
# exactly /phone/pair, /phone/heartbeat, /phone/ping, /phone/status,
# /phone/poll and /phone/ack. Only /phone/pair is unauthenticated, and it
# requires a short-lived 6-digit pairing code shown on the laptop.
JARVIS_PHONE_ENABLED=true
# Bind address for the phone listener. Default 0.0.0.0 (any adapter); to limit
# to one adapter set your LAN IP, e.g. 192.168.1.3.
JARVIS_PHONE_HOST=0.0.0.0
JARVIS_PHONE_PORT=8788

# ──────────────────────────────── BROWSER: AI ───────────────────────────────
# Server-side AI proxy used by the browser for LLM calls. `<dev host>/api/ai`
# on the Vite dev server, or `<backend host>/api/ai` in production. The browser
# must NEVER hold an API key; the proxy injects it server-side.
VITE_JARVIS_AI_PROXY_URL=/api/ai

# Model used for reasoning/chat. (Dev define default: gemini-3.6-flash.)
VITE_JARVIS_AI_MODEL=gemini-3.6-flash

# Optional: talk to an AI host directly instead of through the proxy. Only use
# for keyless/local endpoints — a real key in a VITE_* var would leak to the
# browser. Leave unset to use the proxy.
VITE_JARVIS_AI_BASE_URL=
VITE_JARVIS_AI_TEMPERATURE=
VITE_JARVIS_AI_MAX_TOKENS=

# ──────────────────────────────── BROWSER: VISION ───────────────────────────
# Vision (camera_see) only becomes CONFIGURED when BOTH a base URL and a model
# are declared. Defaults: base URL falls back to VITE_JARVIS_AI_BASE_URL, model
# to the AI model. Requests go through the same proxy routing as chat.
VITE_JARVIS_VISION_BASE_URL=
VITE_JARVIS_VISION_MODEL=

# ──────────────────────────────── BROWSER: EMBEDDINGS ───────────────────────
# Semantic memory only activates when an embedding endpoint is EXPLICITLY
# configured (at least one of PROXY_URL / BASE_URL / MODEL / DIMENSIONS), and
# the proxy must be reachable. Otherwise recall falls back to deterministic
# lexical matching — it never silently pretends to be semantic.
VITE_JARVIS_EMBEDDING_PROXY_URL=/api/ai
VITE_JARVIS_EMBEDDING_BASE_URL=
VITE_JARVIS_EMBEDDING_MODEL=gemini-embedding-2-preview
VITE_JARVIS_EMBEDDING_DIMENSIONS=

# ──────────────────────────────── BROWSER: BACKEND ──────────────────────────
# Persistent backend discovery from the client. Falls back to
# `http://<current hostname>:8787` when unset.
VITE_JARVIS_BACKEND_URL=
VITE_JARVIS_BACKEND_MAX_RECONNECT_ATTEMPTS=6
VITE_JARVIS_BACKEND_RECONNECT_BASE_MS=700
VITE_JARVIS_BACKEND_MIRROR_THROTTLE_MS=1500

# ──────────────────────────────── BROWSER: NATIVE PC AGENT ──────────────────
# Non-secret opt-in indicating that the server-side native agent is configured.
# The browser sends native RPC through the backend; it never receives the agent token.
VITE_NATIVE_AGENT_URL=http://127.0.0.1:8765
