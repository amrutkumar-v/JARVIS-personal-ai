<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="#0b0f19">

    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="JARVIS COMPANION"
        android:textColor="#38bdf8"
        android:textSize="22sp"
        android:textStyle="bold"
        android:letterSpacing="0.05" />

    <TextView
        android:id="@+id/tvSubtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Telephony, Call Audio &amp; Device Bridge"
        android:textColor="#94a3b8"
        android:textSize="13sp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginVertical="16dp"
        android:background="#1e293b" />

    <TextView
        android:id="@+id/tvStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Status: Initializing bridge..."
        android:textColor="#f8fafc"
        android:textSize="15sp" />

    <EditText
        android:id="@+id/etServerUrl"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="#1e293b"
        android:hint="JARVIS PC Core URL (e.g. http://192.168.1.100:3000)"
        android:textColorHint="#64748b"
        android:textColor="#f8fafc"
        android:padding="12dp"
        android:textSize="14sp" />

    <Button
        android:id="@+id/btnConnect"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Connect Bridge"
        android:backgroundTint="#0284c7"
        android:textColor="#ffffff" />

    <TextView
        android:id="@+id/tvCallState"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="Active Call: Idle"
        android:textColor="#94a3b8"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/tvPermissions"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Permissions: Checking..."
        android:textColor="#64748b"
        android:textSize="12sp" />

</LinearLayout>
